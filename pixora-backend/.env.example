# ==========================================
# Pixora Backend - Environment Variables Reference
# ==========================================

# Port (Render/Railway injects PORT automatically)
PORT=8080

# Supabase PostgreSQL Database (Connection Pooler URL with prepareThreshold=0)
DATABASE_URL=jdbc:postgresql://<db-host>:6543/postgres?sslmode=require&prepareThreshold=0
DATABASE_USERNAME=postgres.<project-ref>
DATABASE_PASSWORD=<your-supabase-db-password>

# Supabase Storage REST API (Service Role Key recommended for full storage permissions)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<your-supabase-service-role-key>

# Google Gemini 2.5 Flash Image API Key
GEMINI_API_KEY=your-gemini-api-key-here

# fal.ai API Key for optional secondary fallback
FAL_AI_API_KEY=

# Firebase Authentication Configuration
FIREBASE_PROJECT_ID=pixora-9223f
FIREBASE_CREDENTIALS_JSON=

# Allowed CORS Frontend Origin
FRONTEND_URL=https://pixora.vercel.app
