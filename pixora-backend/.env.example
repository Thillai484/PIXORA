# ==========================================
# Pixora Backend - Environment Variables Reference
# ==========================================

# Port (Render/Railway injects PORT automatically)
PORT=8080

# Supabase PostgreSQL Database (Connection Pooler URL)
# Example: jdbc:postgresql://aws-0-us-west-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=jdbc:postgresql://<db-host>:6543/postgres?sslmode=require
DATABASE_USERNAME=postgres.<project-ref>
DATABASE_PASSWORD=<your-supabase-db-password>

# Supabase Storage REST API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<your-supabase-service-role-or-anon-key>

# fal.ai API Key for Flux image-to-image synthesis
FAL_AI_API_KEY=fal_key_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Firebase Authentication Configuration
FIREBASE_PROJECT_ID=pixora-9223f
# Optional: Paste raw Service Account JSON contents as a string or mount as file
FIREBASE_CREDENTIALS_JSON=

# Allowed CORS Frontend Origin
FRONTEND_URL=https://pixora.vercel.app
